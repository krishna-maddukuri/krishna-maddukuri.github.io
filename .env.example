# Copy to .env.production (not committed) to switch these on for a build.

# Where the site lives: used for the sitemap, each page's canonical address and link previews.
# SITE_URL=https://example.com
# Its sub-path, if it is served from one (GitHub Pages' /repo-name/).
# SITE_BASE=/

# Visit counts (src/lib/analytics.ts). Leave unset and nothing is loaded or sent.
# VITE_ANALYTICS=goatcounter:your-code
# VITE_ANALYTICS=cloudflare:your-token
# VITE_ANALYTICS=plausible:your-domain.com
